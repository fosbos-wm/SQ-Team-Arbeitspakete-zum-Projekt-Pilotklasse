rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Arbeitspakete: nur für angemeldete Nutzer (inkl. anonymer Anmeldung nach PIN-Eingabe) lesbar/schreibbar
    match /arbeitspakete/{docId} {
      allow read, write: if request.auth != null;
    }

    // alles andere gesperrt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
